# =============================================================================
# Ibatiks — contoh konfigurasi environment
# Salin ke .env lalu sesuaikan:  cp .env.example .env
# =============================================================================

# --- Aplikasi ---------------------------------------------------------------
APP_ENV=development                       # development | production
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=info                            # debug | info | warn | error
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Dipakai oleh container postgres untuk membuat database saat pertama kali jalan.
POSTGRES_USER=jastipin
POSTGRES_PASSWORD=ubah_password_ini
POSTGRES_DB=jastipin
POSTGRES_PORT=5432                        # port yang di-publish ke host (dev saja)

# URL koneksi yang dibaca backend. Host "db" adalah nama service di compose.
DATABASE_URL=postgres://jastipin:ubah_password_ini@db:5432/jastipin?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# --- Autentikasi ------------------------------------------------------------
# WAJIB diganti di production, minimal 32 karakter.
# Bikin yang acak:  openssl rand -base64 48
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=jastipin

# --- Penyimpanan berkas -----------------------------------------------------
UPLOAD_DIR=/data/uploads                  # bukti transfer, foto struk
INVOICE_DIR=/data/invoices                # hasil render PDF invoice

# --- Default operasional ----------------------------------------------------
DEFAULT_DP_PERCENT=50                     # persen DP yang diminta saat order dibuat

# --- Akun owner pertama (dipakai oleh perintah seed) -------------------------
SEED_OWNER_NAME=Owner
SEED_OWNER_EMAIL=owner@ibatiks.id
SEED_OWNER_PASSWORD=ubah_password_ini

# --- Frontend ---------------------------------------------------------------
# URL backend dari sisi server Next.js (di dalam jaringan Docker).
BACKEND_INTERNAL_URL=http://backend:8080
# Rahasia untuk mengenkripsi cookie sesi di Next.js. Ganti juga di production.
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
WEB_PORT=3000

# --- Production khusus ------------------------------------------------------
# Domain untuk Caddy (TLS otomatis). Isi saat deploy ke server.
APP_DOMAIN=ibatiks.example.com
# Tag image yang dipakai docker-compose.prod.yml
IMAGE_TAG=latest
IMAGE_REGISTRY=ghcr.io/ipoool
