# Environment — jangan pernah di-commit, isinya rahasia
.env
.env.local
.env.*.local
!.env.example

# Backend
backend/tmp/
backend/data/
backend/bin/
backend/api
backend/migrate
backend/seed

# Frontend
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
web/*.tsbuildinfo

# Data operasional — semuanya diikat ke akar repo dengan garis miring di depan.
# Tanpa itu, "invoices/" cocok dengan direktori bernama invoices di kedalaman
# mana pun, termasuk rute Next.js web/src/app/(dashboard)/invoices — dan halaman
# Invoice diam-diam tidak pernah ikut ter-commit.
#
# /data berisi direktori data PostgreSQL: berkas biner milik server yang sedang
# berjalan, bukan sesuatu yang bisa dibaca atau digabung sebagai teks.
/data/
/backups/
/uploads/
/invoices/

# Editor & sistem
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Log
*.log
npm-debug.log*
.gstack/
